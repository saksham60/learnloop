APP_NAME=AI Student Companion API
APP_ENV=development
APP_DEBUG=false
DEMO_MODE=false
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://learnloop-drab.vercel.app

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/student_companion
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET_TEACHER_CONTENT=teacher-content
SUPABASE_STORAGE_BUCKET_STUDENT_SUBMISSIONS=student-submissions

LLM_PROVIDER=gemma
LLM_ALLOWED_PROVIDERS=gemma
GEMMA_API_BASE_URL=https://your-gemma-gateway.example.com/v1
GEMMA_API_KEY=your-gemma-api-key
GEMMA_MODEL=gemma-4
GEMMA_TEMPERATURE=0.4
GEMMA_MAX_TOKENS=1024
GEMMA_TIMEOUT_SECONDS=60

DIRECT_ANSWER_ALLOWED_BY_DEFAULT=false
MAX_HINTS_PER_QUESTION=3
EXPLAIN_AFTER_ATTEMPTS=2
SOCRATIC_MODE_DEFAULT=true
VECTOR_STORE=pgvector
VECTOR_TABLE=content_chunks
REDIS_URL=redis://localhost:6379/0
QUEUE_PROVIDER=none
AGENT_RUNTIME_ENABLED=true
AGENT_TRACE_ENABLED=true
RULE_ENGINE_ENABLED=true
FOCUS_ENGINE_ENABLED=true
HOMEWORK_ATTEMPT_FIRST=true
ANTI_ANSWER_DUMP_ENABLED=true
LOG_LEVEL=INFO
SENTRY_DSN=
